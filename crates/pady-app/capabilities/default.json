{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call Pady's commands and listen to events.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-save-config",
    "allow-set-enabled",
    "allow-reset-config",
    "allow-set-autostart",
    "allow-test-action",
    "allow-set-live",
    "allow-open-config-folder",
    "allow-open-touchpad-settings",
    "allow-detect-app",
    "allow-fix-permissions",
    "allow-apply-preset",
    "allow-check-update",
    "allow-install-update"
  ]
}
