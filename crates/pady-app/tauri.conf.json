{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pady",
  "version": "0.1.0",
  "identifier": "com.lumidren.pady",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pady",
        "width": 1080,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Pady overlay",
        "width": 300,
        "height": 90,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Custom touchpad gestures",
    "longDescription": "Pady maps three-, four- and five-finger taps, holds, swipes and drags to keyboard shortcuts, volume, brightness, apps and links.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
