{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pady",
  "identifier": "com.lumidren.pady",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pady",
        "width": 1080,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "create": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Pady overlay",
        "width": 300,
        "height": 90,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "visible": false,
        "create": false
      },
      {
        "label": "translate",
        "url": "translate.html",
        "title": "Pady translation",
        "width": 400,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "lumidren",
    "homepage": "https://github.com/lumidren/Pady",
    "copyright": "Copyright © 2026 lumidren",
    "category": "Utility",
    "shortDescription": "Custom touchpad gestures",
    "longDescription": "Pady maps three-, four- and five-finger taps, holds, swipes, pinches and drags to keyboard shortcuts, volume, brightness, apps and links, with per-app profiles.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "compression": "lzma"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ],
        "recommends": [
          "brightnessctl",
          "xdotool",
          "playerctl"
        ],
        "section": "utils",
        "files": {
          "/usr/lib/udev/rules.d/70-pady.rules": "../../packaging/linux/70-pady.rules",
          "/usr/lib/modules-load.d/pady.conf": "../../packaging/linux/modules-load.conf"
        },
        "postInstallScript": "../../packaging/linux/postinst.sh",
        "postRemoveScript": "../../packaging/linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ],
        "recommends": [
          "brightnessctl",
          "xdotool",
          "playerctl"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-pady.rules": "../../packaging/linux/70-pady.rules",
          "/usr/lib/modules-load.d/pady.conf": "../../packaging/linux/modules-load.conf"
        },
        "postInstallScript": "../../packaging/linux/postinst.sh",
        "postRemoveScript": "../../packaging/linux/postrm.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFQTM5NUY2QThGRjZDRTcKUldUbmJQK285cFdqVGd3U21PeVJBSkxZRWZtRVc4ZVlvSm9UYXFrY2c5NEJMYkRzeTB6V2lTSGUK",
      "endpoints": [
        "https://github.com/lumidren/Pady/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
